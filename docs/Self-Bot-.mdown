from telethon import TelegramClient, events
import asyncio

# Replace with your actual API ID and Hash
api_id = 1234567
api_hash = 'your_api_hash_here'

# Create the client and connect
client = TelegramClient('notifier_session', api_id, api_hash)

# List of keywords to watch for (case-insensitive)
KEYWORDS = ['urgent', 'meeting', 'asap', 'important']

@client.on(events.NewMessage)
async def handler(event):
    message_text = event.message.message.lower()
    if any(keyword in message_text for keyword in KEYWORDS):
        sender = await event.get_sender()
        name = sender.username or sender.first_name or "Unknown"
        print(f"\n🔔 Keyword found!")
        print(f"From: {name}")
        print(f"Chat: {event.chat.title if event.chat else 'Private Chat'}")
        print(f"Message: {event.message.message}")

async def main():
    print("🔍 Notifier bot is running... Watching for keywords.")
    await client.run_until_disconnected()

if __name__ == '__main__':
    with client:
        client.loop.run_until_complete(main())

✅ Step 3: Run it

In terminal:

python notifier_bot.py

It will ask for your phone number and Telegram code the first time. After that, it will auto-login from the saved session file (notifier_session.session).
✅ How it works:

    It watches every incoming message.

    If any word in KEYWORDS is found, it prints an alert.

🛠️ You can customize:

    Add your own keywords in the KEYWORDS list.

